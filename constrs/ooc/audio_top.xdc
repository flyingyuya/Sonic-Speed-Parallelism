#=============================================================================
# audio_top.xdc - 音频链路约束（板上管脚待确认后补全）
#-----------------------------------------------------------------------------
# 说明：
#   本文件当前只做**时序约束**，管脚约束留空（board 型号待确认）。
#   阶段一的目标是拿到真实的 Fmax 与资源数据，管脚等确定开发板后一次性补齐。
#=============================================================================

# ---------------------------------------------------------------------------
# 时钟
# ---------------------------------------------------------------------------
# 当前 audio_top 直接吃外部时钟 clk（最终设计里应由 MMCM 从板上晶振生成
# 12.288 MHz）。这里按 **100 MHz 过约束**：
#   - 真实工作频率只有 12.288 MHz（周期 81.38 ns）
#   - 按 100 MHz 约束若能收敛，说明有 8 倍余量，且可以直接看出关键路径在哪
#   - 若只按 12.288 MHz 约束，时序报告全是正裕量，看不出任何优化空间
create_clock -period 10.000 -name clk_audio [get_ports clk]

# 输入/输出延迟（I2S 相对于 BCLK 的建立/保持，粗略值；上板后用示波器校准）
set_input_delay  -clock clk_audio -max 5.0 [get_ports sdin]
set_output_delay -clock clk_audio -max 5.0 [get_ports sdout]
set_output_delay -clock clk_audio -max 5.0 [get_ports {bclk lrclk}]

# 控制端口是慢速静态信号，不加时序约束（改由 CDC 同步器保证）
set_false_path -from [get_ports {band_gain[*] cfg_load bypass}]

# ---------------------------------------------------------------------------
# 时钟不确定性 / 抖动
# ---------------------------------------------------------------------------
set_clock_uncertainty -setup 0.200 [get_clocks clk_audio]
set_clock_uncertainty -hold  0.100 [get_clocks clk_audio]

# ---------------------------------------------------------------------------
# 管脚约束（TODO：确认开发板型号后填写）
# ---------------------------------------------------------------------------
# set_property -dict {PACKAGE_PIN xx IOSTANDARD LVCMOS33} [get_ports clk]
# set_property -dict {PACKAGE_PIN xx IOSTANDARD LVCMOS33} [get_ports bclk]
# ...
# ---------------------------------------------------------------------------
# DRC 降级：管脚尚未分配，暂时把"未约束 IO"降为 warning 以便生成比特流
# **上板前必须删除下面两行**
# ---------------------------------------------------------------------------
set_property SEVERITY {Warning} [get_drc_checks NSTD-1]
set_property SEVERITY {Warning} [get_drc_checks UCIO-1]
