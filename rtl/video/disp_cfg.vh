//=============================================================================
// disp_cfg.vh - 显示布局的唯一真相源（single source of truth）
//-----------------------------------------------------------------------------
// 用法（RTL 和 TB 都这样写）：
//     `include "disp_cfg.vh"
//     parameter integer POL_CX = `DISP_POL_CX,
//
// 综合/仿真时需要把头文件所在目录加进搜索路径：
//   iverilog : -I rtl/video
//   Vivado   : set_property include_dirs {rtl/video} [current_fileset]
//
// 想改布局只改这里，别去动各个模块的默认值
//=============================================================================

//-----------------------------------------------------------------------------
// 屏幕
//-----------------------------------------------------------------------------
`define DISP_HDISP      480
`define DISP_VDISP      272
`define DISP_NBARS      60          // 480/60 = 8 px -> bar_idx = x[8:3]

//-----------------------------------------------------------------------------
// 极坐标区（屏幕上部，水平居中）
//-----------------------------------------------------------------------------
`define DISP_POL_CX     240         // 圆心 x（屏幕水平中心）
`define DISP_POL_CY     78          // 圆心 y（略偏上）
`define DISP_POL_RIN    16          // 内圆半径（辐条起点）
`define DISP_POL_RMAX   62          // 外圆半径（= 振幅上限 46 px）

//-----------------------------------------------------------------------------
// 波形区（屏幕垂直中心，向左右展开）
//-----------------------------------------------------------------------------
`define DISP_WAVE_CY    136         // 中心线（272/2）
`define DISP_WAVE_SH    17          // 采样右移量（18 -> 满量程 31；17 -> 63）
`define DISP_WAVE_AMP   80          // 最大振幅（像素）
`define DISP_WAVE_TH    1           // 线半厚度

//-----------------------------------------------------------------------------
// 柱状频谱区（屏幕下部，UI 按钮条之上）
//-----------------------------------------------------------------------------
`define DISP_BARS_Y0    16          // 上边界（几乎顶到屏幕顶）
`define DISP_BARS_H     256         // 高度（= 512 * 1/2，占屏幕 94%）
`define DISP_BAR_GAP    2           // 每根柱左侧留的空隙（像素）

//-----------------------------------------------------------------------------
// UI 按钮带（屏幕最底部一条）
//-----------------------------------------------------------------------------
`define DISP_UI_NB     8           // 按钮个数（VIEW/SPK/HUE/GAIN/BG/DEMO/IN/SD）
`define DISP_UI_BY0     234         // 带子上边界（= 272 - 38）
`define DISP_UI_BH      38          // 每个按钮高
`define DISP_UI_BW      58          // 每个按钮宽（NB=8 时 8x58+7x2=478 <= 480）
`define DISP_UI_GAP     2

//-----------------------------------------------------------------------------
// 状态文字区（屏幕左上）
//-----------------------------------------------------------------------------
`define DISP_TXT_NLEN   10          // 每行字符数（缩短文本框宽度）
`define DISP_TXT_NL     8           // 行数（6 行配置 + 1 行 IN + 1 行 SD）

//-----------------------------------------------------------------------------
// 展缩把手（屏幕右侧的小三角箭头）
//   折叠时箭头朝右（▶），展开时朝左（◀）
//-----------------------------------------------------------------------------
`define DISP_TAB_X      448         // 把手左上角
`define DISP_TAB_Y      124         // 垂直居中（272/2 - 24/2）
`define DISP_TAB_W      16
`define DISP_TAB_H      24
`define DISP_UI_IDLE_MS 5000        // 空闲多久自动收起（毫秒）
