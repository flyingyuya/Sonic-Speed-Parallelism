//=============================================================================
// disp_cfg.vh - 显示布局的唯一真相源（single source of truth）
//-----------------------------------------------------------------------------
// 为什么要单独一个头文件：
//   这些布局常数同时出现在【RTL】和【TB 的参照实现】里。
//   之前改柱数（30→60）时就因为 TB 里的圆心常量没跟着改，
//   报出 6113 处假错误，查了半天。
//   把常数收进一个头文件，两边 `include 同一份，就不会再错开。
//
// 用法（RTL 和 TB 都这样写）：
//     `include "disp_cfg.vh"
//     parameter integer POL_CX = `DISP_POL_CX,
//
// 综合/仿真时需要把头文件所在目录加进搜索路径：
//   iverilog : -I rtl/video
//   Vivado   : set_property include_dirs {rtl/video} [current_fileset]
//
// ⚠️ 想改布局只改这里，别去动各个模块的默认值。
//=============================================================================

//-----------------------------------------------------------------------------
// 屏幕
//-----------------------------------------------------------------------------
`define DISP_HDISP      480
`define DISP_VDISP      272
`define DISP_NBARS      60          // 480/60 = 8 px -> bar_idx = x[8:3]

//-----------------------------------------------------------------------------
// 极坐标区（屏幕上部，水平居中）
//-----------------------------------------------------------------------------
`define DISP_POL_CX     240         // 圆心 x（屏幕水平中心）
`define DISP_POL_CY     78          // 圆心 y（略偏上）
`define DISP_POL_RIN    16          // 内圆半径（辐条起点）
`define DISP_POL_RMAX   62          // 外圆半径（= 振幅上限 46 px）

//-----------------------------------------------------------------------------
// 波形区（屏幕垂直中心，向左右展开）
//-----------------------------------------------------------------------------
`define DISP_WAVE_CY    136         // 中心线（272/2）
//   ⚠️ 振幅上限不能超过 |s|>>SHIFT 的最大值！原来 >>18 只能到 31，
//      所以 AMP 写超过 31 是没用的（会被钳位卡住）。要放大波形必须
//      同时把 SHIFT 从 18 改成 17（满量程 63）。
`define DISP_WAVE_SH    17          // 采样右移量（18 -> 满量程 31；17 -> 63）
`define DISP_WAVE_AMP   40          // 最大振幅（像素）
`define DISP_WAVE_TH    1           // 线半厚度

//-----------------------------------------------------------------------------
// 柱状频谱区（屏幕下部，UI 按钮条之上）
//-----------------------------------------------------------------------------
// 【2026-10 调整】柱子原来只占 y 176~271（96px，屏幕的 35%），用户反馈太矮看不清。
//   现在抬到 y 80~271（192px，屏幕的 70%）。上面空出的 80px 留给：
//     · 左上角的状态行文字（8 行 x 9px = 72px 高）
//     · 波形（中心 y=136，振幅 +-22）
//   柱子画在最底层，波形/文字盖在上面，所以抬高不会挡住它们。
//   ⚠️ 改这个数【必须】同步改 disp_mix.v 里的柱高系数：
//      系数 = BARS_H / 512。192/512 = 3/8（正好是移位加法，不用乘法器）。
//   【2026-10 再调】用户要求"撑满全屏"（参考 Music-Spectrum 的观感）。
//     256/512 = 1/2 ✗ 系数就是【一次右移】✗ 比 3/8 还干净 ✓
//     上边留 16px 让状态行文字不至于顶到屏幕边缘（文字画在最上层 ✗ 仍可读 ✓）
`define DISP_BARS_Y0    16          // 上边界（几乎顶到屏幕顶）
`define DISP_BARS_H     256         // 高度（= 512 * 1/2，占屏幕 94%）
`define DISP_BAR_GAP    2           // 每根柱左侧留的空隙（像素）

//-----------------------------------------------------------------------------
// UI 按钮带（屏幕最底部一条）
//   为什么放底部：手指够得着。代价是柱状区从 96 px 压到 58 px，
//   所以柱高到像素的系数也要跟着改（见 disp_mix 里的 BAR_NUM/BAR_DEN）。
//-----------------------------------------------------------------------------
`define DISP_UI_NB     8           // 按钮个数（VIEW/STYLE/HUE/GAIN/BG/DEMO/IN/SD）
`define DISP_UI_BY0     234         // 带子上边界（= 272 - 38）
`define DISP_UI_BH      38          // 每个按钮高
// 每按钮宽 × NB + (NB-1) × GAP ≤ 480
//   7 个：7×66  + 6×2 = 474 ✓
//   8 个：8×58  + 7×2 = 478 ✓  ← 加 SD 按钮后必须缩到 58
`define DISP_UI_BW      58          // 每个按钮宽（NB=8 时 8x58+7x2=478 <= 480）
`define DISP_UI_GAP     2

//-----------------------------------------------------------------------------
// 状态文字区（屏幕左上）
//   每行只放 10 个字符：最长的标签是 "E0007 L1"（8 字符），留 2 个余量。
//   原来每行 17 字符 -> 文本框 136 px 宽，太占地方了。
//-----------------------------------------------------------------------------
`define DISP_TXT_NLEN   10          // 每行字符数（缩短文本框宽度）
`define DISP_TXT_NL     7           // 行数（6 行配置 + 1 行 ADC 诊断）

//-----------------------------------------------------------------------------
// 展缩把手（屏幕右侧的小三角箭头）
//   放侧边而不是底部：不占垂直空间，也不用一直显示一条横条。
//   折叠时箭头朝右（▶），展开时朝左（◀）。点它切换。
//-----------------------------------------------------------------------------
`define DISP_TAB_X      448         // 把手左上角
`define DISP_TAB_Y      124         // 垂直居中（272/2 - 24/2）
`define DISP_TAB_W      16
`define DISP_TAB_H      24
`define DISP_UI_IDLE_MS 5000        // 空闲多久自动收起（毫秒）
