#=============================================================================
# drc_waivers.tcl - 有据可依的 DRC 豁免
#-----------------------------------------------------------------------------
# 被 build.tcl 在 report_drc 之前 source。
#
# 【为什么要有这个文件】
#   本工程要求"零 DRC 警告"。但"零警告"有两种做法：
#     (a) 把设计改到警告消失            ← 正确，但要判断代价
#     (b) 把警告藏起来                 ← 自欺欺人
#   这个文件属于 (c)：**逐条讲清楚为什么该警告的前提在本设计里不成立，
#   并记录量化证据**。豁免项会以 "Waived" 形式出现在 DRC 报告里，不是消失。
#
#   真正的原因（异步复位、DRIVE 作用在输入端口）已经【改设计】修掉了，
#   见 docs/08-skills-index.md 第 44、45 条。
#
#-----------------------------------------------------------------------------
# 被豁免的是这三条，全部只针对【DSP48 流水建议】：
#
#   DPIP-1  Input pipelining      - DSP 的 A/B/C 输入没打拍
#   DPOP-1  PREG Output pipelining- DSP 的 P 输出没打拍
#   DPOP-2  MREG Output pipelining- DSP 的 M（乘法级）输出没打拍
#
# 【它们是什么性质】
#   不是"违规"，是【性能/功耗建议】。Vivado 的默认假设是：
#   "DSP 没打拍 → 组合路径长 → 流水化能提高频率"。
#   这个假设在通用设计里成立，但在本设计里**不成立**：
#
#   1) 加了流水线 = 改数值行为。
#      本工程所有 DSP 通路都有 Python 定点黄金模型逐位对拍
#      （EQ 6000 样本、FFT 2048 点、显示 130560 像素全部一致）。
#      给 EQ / FFT / 极坐标插寄存器会改变延迟与中间量，
#      必须重建黄金模型并全量重验 —— 这是实实在在的风险，
#      换来的只是"报告干净"。
#
#   2) 本设计的 DSP 大多在【不可流水化的反馈环里】。
#      EQ 是 direct-form II transposed 双二阶：
#          s1 -> acc -> y -> a1*y -> s1'
#      这个环必须在一个时钟内闭合（biquad-structure-choice.md §3），
#      在环里插寄存器会直接改变滤波器传递函数。
#
#   3) 时序已经收敛且有余量（post-route 实测）：
#          clk_pix (12.5 MHz)  WNS = +41.573 ns
#          clk_sys (48 MHz)    WNS = +1.548  ns
#      最差路径是 FFT 的工作存储器回写（u_fft/mem_re_reg，
#      逻辑级数 32），不是 DSP 本身。
#      即"流水化能提频"是真的，但**我们不需要那个频率**。
#
#   4) 将来若要加 HDMI：它在【另一个时钟域】（74.25 MHz，第二个 MMCM），
#      不与 clk_sys 争资源，所以"留余量给以后"也不构成理由。
#
# 【什么时候应该回来删掉这个豁免】
#   如果以后 clk_sys 出现时序违例，第一件事就是来这里把豁免去掉、
#   重新看这 50 条，按报告指出的具体 DSP 去流水化。
#=============================================================================

set DRC_WAIVER_REASON "本设计的 DSP 通路均有定点黄金模型逐位对拍，插入流水级会改变数值行为，\
需全量重验且无功能收益；EQ 双二阶的反馈环按定义不可流水化。post-route 实测 \
clk_sys WNS=+1.548ns / clk_pix WNS=+41.573ns，时序已收敛。详见 docs/08-skills-index.md 第 46 条。"

foreach rule {DPIP-1 DPOP-1 DPOP-2} {
    if {[llength [get_drc_checks -quiet $rule]] == 0} {
        puts "  \[ waiver \] 规则 $rule 不存在，跳过"
        continue
    }
    create_waiver -type DRC -id $rule -description $DRC_WAIVER_REASON
    puts "  \[ waiver \] 已登记 $rule"
}

puts "  \[ waiver \] 注：豁免项仍会出现在 DRC 报告的 Waived 一节，不会静默消失"
